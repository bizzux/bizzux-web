# Firebase — same project apps.bizzux.com runs on, reused here so existing
# users/customers/team data carry over. Used by every server-side feature:
# the SaaS app (auth, team, admin, billing) AND bizzux.com's own contact
# form / career-applications tool.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
# Comma-separated list of emails that get platform-wide Super Admin access.
SUPER_ADMIN_EMAIL=

# Client-side Firebase config (safe to expose — protected by Firebase
# security rules, not secrecy). Powers sign-in, dashboard, team, etc.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Bizzux Shop SSO hand-off (dashboard "Open app" tile)
SHOP_SSO_SECRET=
# SHOP_URL=http://localhost:3000

# Admin dashboard auth (/admin's Career Applications tab)
SESSION_SECRET=
ADMIN_PASSWORD=

# Razorpay — recurring INR subscriptions (see app/api/checkout/route.js,
# app/api/checkout/verify/route.js, app/api/webhooks/razorpay/route.js).
# NEXT_PUBLIC_RAZORPAY_KEY_ID is safe to expose (it's the public Key ID,
# same value as RAZORPAY_KEY_ID); RAZORPAY_KEY_SECRET and
# RAZORPAY_WEBHOOK_SECRET must stay server-only. Configure the webhook URL
# (https://bizzux.com/api/webhooks/razorpay) in Razorpay Dashboard →
# Settings → Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Stripe — recurring USD subscriptions (see app/api/checkout/route.js,
# app/api/webhooks/stripe/route.js). Configure the webhook URL
# (https://bizzux.com/api/webhooks/stripe) in Stripe Dashboard →
# Developers → Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
